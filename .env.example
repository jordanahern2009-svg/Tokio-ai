# Required: any OpenAI-compatible chat-completions endpoint works.
# Default target is NVIDIA's free NIM catalog: https://build.nvidia.com (free API key, no card)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1

# Required for the SEC filings tool: SEC's fair-access policy requires a
# descriptive User-Agent identifying you. No signup needed, just fill this in.
# https://www.sec.gov/os/webmaster-faq#developers
TOKIO_AI_USER_AGENT=TokIO-AI you@example.com

# Optional: override the default model (see README for tool-calling-reliability notes)
# TOKIO_AI_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
